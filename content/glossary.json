{
  "terms": [
    {"id":"gojoseon","term":"고조선","definition":"한반도 최초의 국가로 전하는 나라. 단군 전승과 위만 조선, 한사군 설치로 이어진다.","track":"korean","aliases":["단군","위만 조선"]},
    {"id":"samhan","term":"삼한","definition":"철기 시대 남부에 형성된 마한·진한·변한. 부여·옥저·동예와 함께 초기 국가를 이룬다.","track":"korean","aliases":["마한","진한","변한"]},
    {"id":"buyeo","term":"부여","definition":"송화강 유역의 초기 국가. 고구려·백제의 기원과 연결된다.","track":"korean","aliases":["옥저","동예"]},
    {"id":"three-kingdoms","term":"삼국","definition":"고구려·백제·신라가 경쟁하며 성장한 고대 국가 체제.","track":"korean","aliases":["고구려","백제","신라"]},
    {"id":"gaya","term":"가야","definition":"낙동강 유역의 연맹 왕국. 철 생산과 해상 교역으로 성장했다.","track":"korean","aliases":["가야 연맹"]},
    {"id":"gwanggaeto","term":"광개토왕","definition":"5세기 초 고구려의 전성기를 연 왕. 광개토왕비에 정복이 기록된다.","track":"korean","aliases":["광개토대왕"]},
    {"id":"silla-unification","term":"신라 통일","definition":"7세기 신라가 당과 연합해 백제·고구려를 멸하고 대동강 이남을 통일한 과정.","track":"korean","aliases":["삼국 통일"]},
    {"id":"balhae","term":"발해","definition":"고구려 유민이 만주·연해주에 세운 나라. 통일 신라와 남북국 시대를 이룬다.","track":"korean","aliases":["대조영","남북국"]},
    {"id":"seokguram","term":"석굴암","definition":"통일 신라 불교 예술의 대표. 석굴암 본존과 불국사 가람이 상징이다.","track":"korean","aliases":["불국사"]},
    {"id":"hwabaek","term":"화백","definition":"신라 귀족의 합의 기구. 중대한 일을 만장일치에 가깝게 결정했다.","track":"korean","aliases":["상대등"]},
    {"id":"golpum","term":"골품제","definition":"신라의 신분제. 관직·혼인·가옥까지 제한했다.","track":"korean","aliases":["진골","성골"]},
    {"id":"goryeo","term":"고려","definition":"후삼국을 통일한 중세 왕조. 문벌 귀족과 불교 문화가 특징이다.","track":"korean","aliases":["왕건"]},
    {"id":"munbeol","term":"문벌 귀족","definition":"고려 전기 음서와 과거로 특권을 누린 귀족층. 이자겸의 난 등과 연결된다.","track":"korean","aliases":["문벌","음서"]},
    {"id":"musin","term":"무신 정권","definition":"1170년 무신 정변 이후 무신이 국정을 장악한 시기.","track":"korean","aliases":["무신 정변","정중부"]},
    {"id":"tripitaka","term":"팔만대장경","definition":"몽골 침입 때 불력으로 외적을 물리치려 판각한 대장경.","track":"korean","aliases":["고려대장경"]},
    {"id":"gongmin","term":"공민왕","definition":"원 간섭을 벗어나려 개혁한 고려 후기 왕. 신진 사대부가 성장한다.","track":"korean","aliases":["신돈","신진 사대부"]},
    {"id":"joseon","term":"조선","definition":"1392년 건국된 유교 왕조. 한양 천도와 관료제 정비가 출발점이다.","track":"korean","aliases":["이성계"]},
    {"id":"hunmin","term":"훈민정음","definition":"세종이 창제한 문자. 백성이 쉽게 배우도록 만들었다.","track":"korean","aliases":["한글","세종"]},
    {"id":"sarim","term":"사림","definition":"지방 사족 출신 신진 관료. 훈구와 대립하며 사화를 겪었다.","track":"korean","aliases":["사화","훈구"]},
    {"id":"bungdang","term":"붕당","definition":"조선 중기 이후 학연·정견으로 나뉜 정당 정치.","track":"korean","aliases":["동인","서인","남인","북인"]},
    {"id":"hwanguk","term":"환국","definition":"조선 후기 붕당이 정권을 급격히 교체한 정치 변동.","track":"korean","aliases":["기사환국","갑술환국"]},
    {"id":"imjin","term":"임진왜란","definition":"1592년 일본의 침략. 수군과 의병이 전세를 바꿨다.","track":"korean","aliases":["임진왜란 1592","이순신"]},
    {"id":"byeongja","term":"병자호란","definition":"1636년 청의 침입. 조선은 청에 사대하게 된다.","track":"korean","aliases":["병자호란 1636"]},
    {"id":"tangpyeong","term":"탕평책","definition":"붕당 갈등을 줄이려 여러 당파를 고루 등용한 정책.","track":"korean","aliases":["영조","정조"]},
    {"id":"sedo","term":"세도 정치","definition":"19세기 외척이 권력을 독점한 정치. 삼정의 문란과 농민 봉기가 뒤따른다.","track":"korean","aliases":["안동 김씨"]},
    {"id":"samjeong","term":"삼정의 문란","definition":"전세·군포·환곡 운영이 문란해져 농민 부담이 커진 현상.","track":"korean","aliases":["전정","군정","환곡"]},
    {"id":"silhak","term":"실학","definition":"조선 후기 현실 개혁을 추구한 학풍. 토지·상업·과학에 관심을 두었다.","track":"korean","aliases":["실학자","북학"]},
    {"id":"daedong","term":"대동법","definition":"공물을 쌀 등으로 거두는 세제. 선혜청이 운영했다.","track":"korean","aliases":["대동","선혜청"]},
    {"id":"gyunyeok","term":"균역법","definition":"군포 부담을 줄이고 균등하게 맞추려 한 세제.","track":"korean","aliases":["균역"]},
    {"id":"heungseon","term":"흥선 대원군","definition":"고종 초 섭정하며 서원 철폐·호포제·경복궁 중건을 추진했다.","track":"korean","aliases":["대원군","쇄국"]},
    {"id":"ganghwa","term":"강화도 조약","definition":"1876년 일본과 맺은 불평등 조약. 근대 개항의 시작이다.","track":"korean","aliases":["강화도 조약 1876"]},
    {"id":"imogapshin","term":"임오군란","definition":"1882년 구식 군인의 봉기. 청의 내정 간섭이 강해졌다.","track":"korean","aliases":["임오"]},
    {"id":"gapsin","term":"갑신정변","definition":"1884년 급진 개화파의 쿠데타. 3일 천하로 끝났다.","track":"korean","aliases":["갑신"]},
    {"id":"donghak","term":"동학 농민 운동","definition":"1894년 반봉건·반외세 농민 항쟁. 갑오개혁의 배경이 된다.","track":"korean","aliases":["동학","갑오농민"]},
    {"id":"gabo","term":"갑오개혁","definition":"1894년 신분제 폐지 등 근대 개혁. 일본의 내정 간섭 아래 진행됐다.","track":"korean","aliases":["갑오경장"]},
    {"id":"eulmi","term":"을미사변","definition":"1895년 일본이 명성황후를 시해한 사건. 단발령과 아관파천으로 이어진다.","track":"korean","aliases":["명성황후"]},
    {"id":"daehan","term":"대한제국","definition":"1897년 고종이 선포한 제국. 자주 근대화를 내세웠다.","track":"korean","aliases":["광무개혁"]},
    {"id":"eulsa","term":"을사늑약","definition":"1905년 외교권을 빼앗긴 보호국화 조약.","track":"korean","aliases":["을사조약 1905"]},
    {"id":"gukchae","term":"국채 보상 운동","definition":"1907년 국민이 빚을 갚아 국권을 지키려 한 민간 운동.","track":"korean","aliases":["국채보상"]},
    {"id":"annexation","term":"한일 병합","definition":"1910년 대한제국이 일본에 병합된 사건.","track":"korean","aliases":["경술국치","1910"]},
    {"id":"samil","term":"3·1 운동","definition":"1919년 전국적 독립 시위. 대한민국 임시 정부 수립으로 이어진다.","track":"korean","aliases":["기미독립","1919"]},
    {"id":"imsi","term":"대한민국 임시 정부","definition":"1919년 상하이에 수립된 망명 정부. 삼권 분립을 표방했다.","track":"korean","aliases":["임시 정부"]},
    {"id":"buna","term":"무단 통치","definition":"1910년대 헌병 경찰로 억압한 식민 통치 방식.","track":"korean","aliases":["헌병 경찰"]},
    {"id":"munhwa","term":"문화 통치","definition":"3·1 운동 이후 표면적 유화와 기만적 회유를 섞은 통치.","track":"korean","aliases":["민족 분열"]},
    {"id":"mulsa","term":"물산 장려 운동","definition":"1920년대 국산품 애용·실력 양성 계열의 경제 운동.","track":"korean","aliases":["물산장려"]},
    {"id":"gwangju-st","term":"광주 학생 항일","definition":"1929년 학생들의 항일 운동. 전국으로 확산됐다.","track":"korean","aliases":["광주학생"]},
    {"id":"liberation","term":"8·15 광복","definition":"1945년 일제 패망으로 맞이한 해방. 곧 분단 정국이 시작된다.","track":"korean","aliases":["광복 1945"]},
    {"id":"division","term":"분단","definition":"북위 38도를 경계로 미·소가 분할 점령하면서 시작된 분단.","track":"korean","aliases":["38선","군정"]},
    {"id":"gov1948","term":"대한민국 정부 수립","definition":"1948년 남쪽에 수립된 정부. 같은 해 북한도 정권을 세웠다.","track":"korean","aliases":["1948.8.15"]},
    {"id":"korean-war","term":"6·25 전쟁","definition":"1950년 북한의 남침으로 시작된 전쟁. 정전 협정으로 휴전이 유지된다.","track":"korean","aliases":["한국 전쟁"]},
    {"id":"april19","term":"4·19 혁명","definition":"1960년 부정 선거에 맞선 민주화 혁명. 이승만 하야로 이어진다.","track":"korean","aliases":["4월 혁명"]},
    {"id":"may16","term":"5·16","definition":"1961년 군사 정변. 이후 경제 개발과 권위주의가 병행된다.","track":"korean","aliases":["박정희"]},
    {"id":"yushin","term":"유신","definition":"1972년 대통령 권한을 강화한 체제. 긴급 조치가 잇따랐다.","track":"korean","aliases":["10월 유신"]},
    {"id":"gwangju518","term":"5·18 민주화운동","definition":"1980년 광주의 민주화 항쟁. 이후 민주화의 상징이 된다.","track":"korean","aliases":["광주 민주화"]},
    {"id":"june","term":"6월 민주 항쟁","definition":"1987년 호헌 철폐·직선제 개헌을 이끌어 낸 시민 항쟁.","track":"korean","aliases":["6·10","6·29 선언"]},
    {"id":"imf","term":"외환 위기","definition":"1997년 외환 위기로 구조 조정과 사회 변화가 가속됐다.","track":"korean","aliases":["IMF"]},
    {"id":"civilization","term":"문명","definition":"도시·문자·국가가 나타난 단계. 하천 유역에서 먼저 성장했다.","track":"world","aliases":["4대 문명"]},
    {"id":"hammurabi","term":"함무라비 법전","definition":"고대 바빌로니아의 성문법. ‘눈에는 눈’으로 알려진 조항이 있다.","track":"world","aliases":["함무라비"]},
    {"id":"pyramid","term":"피라미드","definition":"이집트 왕의 무덤이자 왕권의 상징.","track":"world","aliases":["파라오"]},
    {"id":"indus","term":"인더스 문명","definition":"계획도시와 인장을 남긴 인도 아대륙의 초기 문명.","track":"world","aliases":["하라파","모헨조다로"]},
    {"id":"shang","term":"상·주","definition":"황하 유역의 초기 왕조. 주는 봉건적 질서로 영역을 관리했다.","track":"world","aliases":["은허","봉건"]},
    {"id":"confucius","term":"유교","definition":"인·예를 중시한 사상. 동아시아 통치 이념이 되었다.","track":"world","aliases":["공자","유가"]},
    {"id":"buddhism","term":"불교","definition":"고타마 싯다르타가 연 종교. 아시아 각지로 전파됐다.","track":"both","aliases":["석가모니"]},
    {"id":"qin","term":"진 통일","definition":"기원전 221년 중국을 처음 통일한 진. 군현제와 도량형 통일을 추진했다.","track":"world","aliases":["시황제","분서갱유"]},
    {"id":"han","term":"한","definition":"진 이후 장수한 제국. 유교 관료제와 서역 교역이 확대됐다.","track":"world","aliases":["한 무제","실크로드"]},
    {"id":"tang","term":"당","definition":"국제 도시 장안을 중심으로 한 동아시아 질서의 한 축.","track":"world","aliases":["장안","율령"]},
    {"id":"song","term":"송","definition":"문치와 상업·유학이 발달한 시대. 거란·금·몽골의 압박을 받았다.","track":"world","aliases":["문치","성리학"]},
    {"id":"yuan","term":"원","definition":"몽골이 세운 중국 왕조. 유라시아 교역망이 넓어졌다.","track":"world","aliases":["몽골 제국","쿠빌라이"]},
    {"id":"ming","term":"명","definition":"한족 왕조 회복. 해금과 조공 질서를 운용했다.","track":"world","aliases":["홍무제","정화"]},
    {"id":"qing","term":"청","definition":"만주족이 세운 마지막 왕조. 영역이 크게 넓어졌다.","track":"world","aliases":["만주","강희"]},
    {"id":"polis","term":"폴리스","definition":"고대 그리스의 도시 국가. 시민 정치와 전쟁이 특징이다.","track":"world","aliases":["아테네","스파르타"]},
    {"id":"democracy","term":"민주정","definition":"아테네에서 발달한 시민 참정 제도. 여성·노예는 제외됐다.","track":"world","aliases":["페리클레스"]},
    {"id":"alexander","term":"알렉산드로스","definition":"마케도니아의 정복으로 그리스·오리엔트가 섞인 헬레니즘 세계가 열렸다.","track":"world","aliases":["헬레니즘"]},
    {"id":"roman-rep","term":"로마 공화정","definition":"원로원과 집정관 중심의 체제. 영토 팽창 후 내란이 잦아졌다.","track":"world","aliases":["원로원","포에니"]},
    {"id":"roman-emp","term":"로마 제정","definition":"아우구스투스 이후 황제가 통치한 시기. 팍스 로마나가 이어진다.","track":"world","aliases":["아우구스투스"]},
    {"id":"christianity","term":"크리스트교","definition":"로마 제국에서 공인·국교화되며 유럽 중세의 중심 신앙이 된다.","track":"world","aliases":["기독교","콘스탄티누스"]},
    {"id":"feudalism","term":"봉건제","definition":"주종 관계와 장원을 바탕으로 한 중세 서유럽 질서.","track":"world","aliases":["장원","기사"]},
    {"id":"papacy","term":"교황권","definition":"서유럽 교회 질서의 정점. 세속 군주와 대립·협력했다.","track":"world","aliases":["가톨릭"]},
    {"id":"byzantium","term":"비잔티움","definition":"동로마 제국. 로마법을 계승하고 정교회 문화를 발전시켰다.","track":"world","aliases":["동로마","유스티니아누스"]},
    {"id":"islam","term":"이슬람","definition":"7세기 아라비아에서 성립한 종교·문명. 빠르게 팽창했다.","track":"world","aliases":["무함마드","칼리프"]},
    {"id":"crusades","term":"십자군","definition":"성지 회복을 명분으로 한 원정. 동서 교류와 교황권 변화를 남겼다.","track":"world","aliases":["예루살렘"]},
    {"id":"renaissance","term":"르네상스","definition":"그리스·로마 문화를 재발견한 지적·예술 운동.","track":"world","aliases":["인문주의"]},
    {"id":"reformation","term":"종교 개혁","definition":"면벌부 비판에서 시작된 교회 개혁. 신교가 갈라졌다.","track":"world","aliases":["루터","칼뱅"]},
    {"id":"exploration","term":"신항로 개척","definition":"유럽이 신항로를 열어 아메리카·아시아와 직접 연결한 과정.","track":"world","aliases":["콜럼버스","바스코 다 가마"]},
    {"id":"absolutism","term":"절대 왕정","definition":"상비군·관료제·중상주의로 왕권을 강화한 체제.","track":"world","aliases":["왕권신수"]},
    {"id":"enlightenment","term":"계몽사상","definition":"이성과 자연권을 내세운 사상. 시민 혁명의 이론적 배경이 된다.","track":"world","aliases":["계몽주의"]},
    {"id":"english-rev","term":"영국 혁명","definition":"의회와 왕의 대립 끝에 입헌 정치의 토대를 만든 혁명.","track":"world","aliases":["청교도 혁명","명예혁명"]},
    {"id":"american-rev","term":"미국 혁명","definition":"영국 식민지가 독립하여 공화정을 세운 혁명.","track":"world","aliases":["독립 선언"]},
    {"id":"french-rev","term":"프랑스 혁명","definition":"구체제를 무너뜨리고 시민의 권리를 내세운 혁명.","track":"world","aliases":["인권 선언","나폴레옹"]},
    {"id":"industrial-rev","term":"산업 혁명","definition":"기계와 공장으로 생산 방식이 바뀐 변혁. 노동 문제와 사회 사상이 등장한다.","track":"world","aliases":["기계제 공장"]},
    {"id":"imperialism","term":"제국주의","definition":"산업 자본주의 열강이 식민지를 나눠 가진 팽창.","track":"world","aliases":["식민지 분할"]},
    {"id":"ww1","term":"제1차 세계 대전","definition":"1914~1918 총력전. 제국이 해체되고 베르사유 체제가 들어선다.","track":"world","aliases":["사라예보"]},
    {"id":"russian-rev","term":"러시아 혁명","definition":"1917년 혁명으로 사회주의 정권이 수립됐다.","track":"world","aliases":["볼셰비키","레닌"]},
    {"id":"depression","term":"대공황","definition":"세계 경제 위기. 뉴딜과 전체주의가 각각 대응으로 나타났다.","track":"world","aliases":["1929"]},
    {"id":"ww2","term":"제2차 세계 대전","definition":"1939~1945 전쟁. 전후 유엔과 냉전이 이어진다.","track":"world","aliases":["파시즘","홀로코스트"]},
    {"id":"cold-war","term":"냉전","definition":"미·소 중심의 이념·군사 대립. 열전과 대리전이 곳곳에서 일어났다.","track":"world","aliases":["미국","소련"]},
    {"id":"nonalign","term":"비동맹","definition":"냉전 블록에 가담하지 않으려 한 신생 독립국 연대.","track":"world","aliases":["제3세계","반둥"]},
    {"id":"detente","term":"데탕트","definition":"1960~70년대 긴장 완화. 이후 신냉전을 거쳐 냉전이 끝난다.","track":"world","aliases":["긴장 완화"]},
    {"id":"globalization","term":"세계화","definition":"교역·정보·인구 이동이 밀접해진 질서. 동시에 다극화가 진행된다.","track":"both","aliases":["다극화"]},
    {"id":"climate","term":"기후 위기","definition":"지구 온난과 환경 문제가 국제 의제가 된 21세기 과제.","track":"world","aliases":["파리 협정"]},
    {"id":"silk-road","term":"실크로드","definition":"유라시아를 잇는 교역로. 물자뿐 아니라 종교·기술도 이동했다.","track":"both","aliases":["비단길"]},
    {"id":"confucian-state","term":"유교 정치","definition":"유교 이념으로 관료와 사회 질서를 운영한 동아시아 통치 방식.","track":"both","aliases":["성리학"]}
