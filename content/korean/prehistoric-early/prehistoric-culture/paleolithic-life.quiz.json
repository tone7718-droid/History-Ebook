  "questions": [
    {"id": "q1", "prompt": "구석기 시대 사람들의 기본 생업과 거주 방식으로 가장 알맞은 것은?", "choices": [{"id": "a", "text": "벽농사와 움집 정착"}, {"id": "b", "text": "사냥·채집과 이동 생활"}, {"id": "c", "text": "민무늬 토기 제작과 고인돌 축조"}, {"id": "d", "text": "철제 농기구 보급과 군장 사회"}], "answer": "b", "explanation": "구석기는 사냥·채집과 이동 생활이 핵심이다."},
    {"id": "q2", "prompt": "전기 구석기를 상징하는 양면 가공의 다용도 뗤석기는?", "choices": [{"id": "a", "text": "빗살무늬 토기"}, {"id": "b", "text": "갈돌·갈판"}, {"id": "c", "text": "주먹도끼"}, {"id": "d", "text": "비파형 동검"}], "answer": "c", "explanation": "주먹도끼는 구석기의 대표 뗤석기이다."},
    {"id": "q3", "prompt": "후기 구석기에 자루에 끼워 찌르는 데 쓰인 도구는?", "choices": [{"id": "a", "text": "민무늬 토기"}, {"id": "b", "text": "고인돌"}, {"id": "c", "text": "소도"}, {"id": "d", "text": "슴베찌르개"}], "answer": "d", "explanation": "슴베찌르개는 후기 구석기의 세련된 석기이다."},
    {"id": "q4", "prompt": "구석기 생활에서 불 사용의 영향으로 보기 어려운 것은?", "choices": [{"id": "a", "text": "빗살무늬 토기를 구워 정착 마을을 세움"}, {"id": "b", "text": "보온과 야생동물로부터의 방어"}, {"id": "c", "text": "고기를 익혀 먹는 조리"}, {"id": "d", "text": "밤 활동과 모임 공간의 확대"}], "answer": "a", "explanation": "빗살무늬 토기와 정착 마을은 신석기의 특징이다."},
    {"id": "q5", "prompt": "구석기 석기와 신석기 석기를 구분하는 핵심 기준으로 가장 알맞은 것은?", "choices": [{"id": "a", "text": "청동으로 만들었는지 철로 만들었는지"}, {"id": "b", "text": "뗤석기(깨 돌)와 간석기(간 돌)의 제작법 차이"}, {"id": "c", "text": "고인돌에 묻혔는지 여부"}, {"id": "d", "text": "한의 군현에 편입되었는지 여부"}], "answer": "b", "explanation": "구석기는 뗤석기, 신석기는 간석기가 대표적이다."}
  ]
