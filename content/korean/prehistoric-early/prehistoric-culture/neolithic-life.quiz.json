    {"id": "q1", "prompt": "신석기 문화를 상징하는 토기로 가장 알맞은 것은?", "choices": [{"id": "a", "text": "민무늬 토기"}, {"id": "b", "text": "빗살무늬 토기"}, {"id": "c", "text": "청동 제기"}, {"id": "d", "text": "철제 솥"}], "answer": "b", "explanation": "빗살무늬 토기는 신석기의 대표 유물이다."},
    {"id": "q2", "prompt": "신석기 시대 사람들이 정착 생활을 하게 된 배경으로 가장 적절한 것은?", "choices": [{"id": "a", "text": "위만이 왕위를 차지하여 도읍을 옮김"}, {"id": "b", "text": "한의 침공으로 군현이 설치됨"}, {"id": "c", "text": "농경이 시작되어 한곳에서 가꾸고 거둘 필요가 생김"}, {"id": "d", "text": "비파형 동검으로 군장이 전쟁을 이끌음"}], "answer": "c", "explanation": "농경은 정착을 강화하는 핵심 요인이다."},
    {"id": "q3", "prompt": "곡물이나 견과를 갈아 가루로 만드는 신석기 도구는?", "choices": [{"id": "a", "text": "주먹도끼"}, {"id": "b", "text": "슴베찌르개"}, {"id": "c", "text": "비파형 동검"}, {"id": "d", "text": "갈돌·갈판"}], "answer": "d", "explanation": "갈돌·갈판은 신석기의 가공 도구이다."},
    {"id": "q4", "prompt": "신석기 취락의 대표적 주거 형태로 알맞은 것은?", "choices": [{"id": "a", "text": "움집"}, {"id": "b", "text": "고인돌"}, {"id": "c", "text": "왕검성"}, {"id": "d", "text": "소도"}], "answer": "a", "explanation": "움집은 신석기 정착 취락의 주거이다."},
    {"id": "q5", "prompt": "자연물·사물에 영혼이 있다고 여기는 신석기 신앙 경향을 가리키는 말은?", "choices": [{"id": "a", "text": "8조법"}, {"id": "b", "text": "애니미즘"}, {"id": "c", "text": "책화"}, {"id": "d", "text": "영고"}], "answer": "b", "explanation": "애니미즘은 신석기 신앙으로 자주 설명된다."}
