  "questions": [
    {"id": "q1", "prompt": "신라에서 관직·신분과 맞물려 토지·노동력 지배의 기반으로 자주 거론되는 것은?", "choices": [{"id": "a", "text": "균역법"}, {"id": "b", "text": "녹읍"}, {"id": "c", "text": "대동법"}, {"id": "d", "text": "영정법"}], "answer": "b", "explanation": "녹읍은 관직과 연계되어 토지와 사람을 함께 거두는 성격이 강했다."},
    {"id": "q2", "prompt": "신라의 신분제로 관직 상한을 규정한 것은?", "choices": [{"id": "a", "text": "과거제"}, {"id": "b", "text": "호패법"}, {"id": "c", "text": "골품제"}, {"id": "d", "text": "서원·향약"}], "answer": "c", "explanation": "골품제는 신라 신분·관직 질서의 핵심이다."},
    {"id": "q3", "prompt": "조·용·조(租·庸·調)에서 ‘용(庸)’이 가리키는 바에 가까운 것은?", "choices": [{"id": "a", "text": "토지세만"}, {"id": "b", "text": "해상 무역세만"}, {"id": "c", "text": "과거 응시료"}, {"id": "d", "text": "요역·노동 부담"}], "answer": "d", "explanation": "용은 노동·요역에 해당한다."},
    {"id": "q4", "prompt": "고대 수취·생산의 기본 단위로 알맞은 것은?", "choices": [{"id": "a", "text": "촌락"}, {"id": "b", "text": "규장각"}, {"id": "c", "text": "비변사"}, {"id": "d", "text": "정동행성"}], "answer": "a", "explanation": "촌락이 생산과 세금·요역 동원의 현장 단위였다."},
    {"id": "q5", "prompt": "통일 신라에서 녹읍을 줄이고 관리 수입을 왕실 규칙 안에 두려 한 방향으로 알맞은 것은?", "choices": [{"id": "a", "text": "과전법 시행(조선)"}, {"id": "b", "text": "관료전으로의 전환 시도"}, {"id": "c", "text": "전시과 폐지"}, {"id": "d", "text": "공음전 신설(고려)"}], "answer": "b", "explanation": "통일 신라는 녹읍을 관료전으로 바꾸려는 개혁을 추진했다."}
  ]
}
